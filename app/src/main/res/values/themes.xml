<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GluedOTT" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ott_accent_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ott_accent_gold</item>
        <item name="android:windowBackground">@color/ott_background</item>
        <item name="android:colorBackground">@color/ott_background</item>
        <item name="colorSurface">@color/ott_surface</item>
        <item name="colorOnSurface">@color/ott_text_primary</item>
        <item name="android:statusBarColor">@color/ott_background</item>
        <item name="android:navigationBarColor">@color/ott_background</item>
    </style>

    <style name="Theme.GluedOTT" parent="Base.Theme.GluedOTT" />

    <!-- Immersive Player Theme -->
    <style name="Theme.GluedOTT.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- Cinematic Splash Theme -->
    <style name="Theme.GluedOTT.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ott_background</item>
        <item name="android:statusBarColor">@color/ott_background</item>
        <item name="android:navigationBarColor">@color/ott_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ott_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
    </style>
</resources>